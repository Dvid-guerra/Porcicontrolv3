rules_version = '2';

// Permisos de Porcicontrol.
//
// Cada cuenta tiene un documento en artifacts/{appId}/members/{uid}:
//   { active: true|false, role: 'admin' | 'empleado' | 'pendiente', email, nombre }
//
// - admin:     lee y escribe todo (app principal).
// - empleado:  solo lee el catálogo saneado (corrales y productos, sin precios) y
//              crea "capturas" que un admin aprueba después. No ve la granja.
// - pendiente / sin documento: nada. Crear una cuenta ya no da acceso.
//
// Un miembro activo sin campo `role` cuenta como admin (membresías creadas antes
// de que existieran los roles).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function rutaMiembro(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/members/$(request.auth.uid);
    }

    function miembroActivo(appId) {
      return signedIn()
        && exists(rutaMiembro(appId))
        && get(rutaMiembro(appId)).data.active == true;
    }

    function rolDe(appId) {
      return get(rutaMiembro(appId)).data.get('role', 'admin');
    }

    function esAdmin(appId) {
      return miembroActivo(appId) && rolDe(appId) == 'admin';
    }

    function esEmpleado(appId) {
      return miembroActivo(appId) && rolDe(appId) == 'empleado';
    }

    function correoActual() {
      return request.auth.token.get('email', '').lower();
    }
    function invitacion(appId) {
      return /databases/$(database)/documents/artifacts/$(appId)/invitaciones/$(correoActual());
    }
    match /artifacts/{appId}/invitaciones/{correo} {
      allow get: if esAdmin(appId) || (signedIn() && correo == correoActual());
      allow list, create, update: if esAdmin(appId);
      allow delete: if esAdmin(appId) || (signedIn() && correo == correoActual()
        && request.auth.token.get('email_verified', false));
    }
    // Membresías. Cualquiera con sesión puede dejar SU solicitud (siempre inactiva);
    // solo un admin la activa, le cambia el rol o la borra.
    match /artifacts/{appId}/members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || esAdmin(appId));
      allow list: if esAdmin(appId);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['active', 'role', 'email', 'nombre', 'solicitadoEn'])
        && request.resource.data.active == false
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.role == 'pendiente';
      allow update: if esAdmin(appId) || (signedIn() && uid == request.auth.uid
        && request.auth.token.get('email_verified', false) && resource.data.active == false
        && exists(invitacion(appId)) && !existsAfter(invitacion(appId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'active'])
        && request.resource.data.active == true && request.resource.data.role == 'empleado');
      allow delete: if esAdmin(appId);
    }

    // Datos de la granja (lotes, bodega, ventas, finanzas): solo administradores.
    match /artifacts/{appId}/public/data/granja_compartida/{key} {
      allow read, write: if esAdmin(appId);
    }

    // Catálogo de trabajo sin precios. Otros documentos son administrativos.
    match /artifacts/{appId}/public/data/granja_empleados/{docId} {
      allow read: if esAdmin(appId) || (docId == 'catalogo' && esEmpleado(appId));
      allow write: if esAdmin(appId);
    }

    // Capturas de empleados. El empleado crea y puede borrar mientras siga pendiente;
    // aprobar, rechazar o editar es cosa del admin.
    match /artifacts/{appId}/public/data/granja_capturas/{capturaId} {
      function propia() {
        return esEmpleado(appId) && resource.data.creadaPorUid == request.auth.uid;
      }

      function datosValidos(d) {
        let base = ['tipo', 'estado', 'corralId', 'corralNombre', 'loteId', 'loteNombre',
                    'fecha', 'empleado', 'nota', 'creadaEn', 'creadaPorUid', 'cantidad'];
        return d.keys().hasAll(base)
          && d.creadaPorUid == request.auth.uid && d.estado == 'pendiente'
          && d.corralId is string && d.corralNombre is string && d.loteId is string && d.loteNombre is string
          && d.loteId.size() > 0 && d.corralId.size() > 0
          && d.empleado == request.auth.token.get('email', request.auth.uid)
          && d.fecha is string && d.fecha.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.nota is string && d.nota.size() <= 300 && d.creadaEn is int
          && d.cantidad is number && d.cantidad > 0
          && ((d.tipo == 'concentrado' && d.keys().hasOnly(base.concat(['alimento', 'unidad', 'fase']))
               && d.alimento is string && d.fase is number
               && ((d.unidad == 'lb' && d.cantidad <= 20000) || (d.unidad == 'sacos' && d.cantidad <= 200)))
           || (d.tipo in ['medicamento', 'insumo'] && d.keys().hasOnly(base.concat(['productoId', 'nombre', 'unidad']))
               && d.productoId is string && d.nombre is string && d.unidad is string && d.cantidad <= 10000
               && (d.tipo == 'medicamento' || d.productoId.size() > 0))
           || (d.tipo == 'baja' && d.keys().hasOnly(base.concat(['causa']))
               && d.cantidad is int && d.causa is string && d.causa.size() > 0));
      }

      allow read: if esAdmin(appId) || propia();
      allow create: if esEmpleado(appId) && datosValidos(request.resource.data);
      allow update: if esAdmin(appId) && resource.data.estado == 'pendiente'
        && request.resource.data.estado in ['aplicada', 'rechazada'];
      allow delete: if esAdmin(appId) || (propia() && resource.data.estado == 'pendiente');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
